# Copy to .env for local overrides. Real environment variables always win.

# Environment profile from config/environments.js: local | ci | staging
TEST_ENV=local

# Override the profile's URL (e.g. a review app or staging deployment)
# BASE_URL=http://localhost:3000

# Key for the test-support API that creates isolated test data.
# Store real keys as CI secrets, never in the repository.
# TEST_SUPPORT_KEY=local-test-key

# Set to false when testing an environment that is already running
# START_SERVER=true

# Execution
# RETRIES=0
# WORKERS=4
# HEADLESS=true

# Timeouts in milliseconds
# TEST_TIMEOUT=30000
# EXPECT_TIMEOUT=5000

# debug | info | warn | error
# LOG_LEVEL=warn
